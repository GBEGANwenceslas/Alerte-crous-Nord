# Copiez ce fichier en ".env" et remplissez vos propres valeurs.

# Token du bot Telegram, obtenu via @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExempleDeTokenBotFather

# Identifiant du chat (le vôtre, ou celui d'un groupe) qui recevra les alertes
TELEGRAM_CHAT_ID=123456789

# Rectangle géographique de recherche : "lonNO_latNO_lonSE_latSE"
# La valeur par défaut couvre tout le Nord + Pas-de-Calais.
CROUS_BOUNDS=1.30_51.20_4.30_49.90

# Fréquence de vérification en secondes (utilisé seulement par crous_bot/main.py,
# pas par run_once.py qui est piloté par GitHub Actions / cron)
POLL_INTERVAL_SECONDS=300

# Fichier où sont mémorisés les logements déjà notifiés
DB_PATH=logements_vus.json

# Optionnel : ne garder que certaines villes (ex: MEL uniquement), séparées par des virgules.
# Laisser vide pour garder toute la zone Nord-Pas-de-Calais.
CROUS_VILLES_FILTRE=
